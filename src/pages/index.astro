---
import SiteLayout from "../layouts/SiteLayout.astro";

const title = "Technology for Organizations | Cassady Tech Solutions";
const description = "Cassady Tech Solutions is a practical technology partner for 5 to 50 person organizations that need assessments, projects, advisory support, incident help, cybersecurity, and responsible modernization.";

const friction = [
	["Work gets stuck", "A device, account, network, vendor, or cloud problem keeps pulling leadership into technical details."],
	["Nobody has the whole picture", "Vendors, subscriptions, backups, users, systems, and responsibilities grow faster than the documentation."],
	["The next move is unclear", "A migration, security concern, AI idea, or recurring problem needs someone to understand the environment before recommending another tool."],
];

const relationship = [
	["Start with the real problem", "Bring the outage, decision, project, recurring frustration, or technology question that is getting in the way."],
	["Define a useful piece of work", "We learn enough of the environment to separate the immediate need from everything else we notice, then scope the work that actually matters."],
	["Build from what works", "A successful project can lead to another project, advisory help, or an ongoing relationship when the organization truly needs it. Monthly service is not the required destination."],
];
---

<SiteLayout title={title} description={description} active="home">
	<section class="hero hero-cts">
		<div class="section-inner hero-inner">
			<div class="hero-copy">
				<p class="eyebrow">Technology for organizations</p>
				<h1>Clear direction for your technology.</h1>
				<p class="lead">IT consulting, cybersecurity, and AI readiness for small organizations in Southern Colorado. Start with a clear assessment, a defined project, or practical advice.</p>
				<div class="actions">
					<a class="button" href="/contact">Discuss your project</a>
					<a class="button secondary" href="/services">See how we help</a>
				</div>
				<p class="hero-note-line"><span class="signal-dot"></span>Built for organizations with roughly 5 to 50 people and real work to protect.</p>
			</div>
			<figure class="hero-side brand-feature">
                <img src="/assets/brand/cts-emblem.svg" alt="Cassady Tech Solutions silver-rimmed mountain and circuit river emblem" width="443" height="452" fetchpriority="high" />
                <figcaption>DON’T JUST FIX TECHNOLOGY.<br /><strong>MAKE IT USEFUL.</strong></figcaption>
            </figure>
		</div>
	</section>

	<section class="signal-section">
		<div class="section-inner signal-grid">
			<div class="section-heading narrow-heading">
				<p class="eyebrow">The gap we fill</p>
				<h2>Practical help for the problems slowing your organization down.</h2>
			</div>
			<div class="friction-list">
				{friction.map(([titleText, text], index) => (
					<article class="friction-row">
						<span class="row-number">0{index + 1}</span>
						<div><h3>{titleText}</h3><p>{text}</p></div>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section relationship-section">
		<div class="section-inner">
			<div class="section-heading wide-heading">
				<p class="eyebrow">The relationship</p>
				<h2>Start with useful work. Earn the deeper relationship.</h2>
				<p>We do not assume every organization should buy a monthly technology package. The relationship can begin with one defined problem and grow only when the work proves there is value in doing more together.</p>
			</div>
			<div class="relationship-grid">
				{relationship.map(([titleText, text], index) => (
					<article class="relationship-step">
						<span class="step-number">{String(index + 1).padStart(2, "0")}</span>
						<h3>{titleText}</h3>
						<p>{text}</p>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section offer-section">
		<div class="section-inner offer-layout">
			<div class="offer-lead">
				<p class="eyebrow">Ways we can help</p>
				<h2>Defined enough to control scope. Flexible enough to fit the organization.</h2>
				<p>CTS is built around assessments, projects, advisory work, incident help, and repeat customer relationships. Ongoing managed responsibility is available selectively when it is actually the right fit.</p>
				<a class="text-link" href="/services">Explore the service areas <span aria-hidden="true">&#8594;</span></a>
			</div>
			<div class="offer-list">
				<article><span class="offer-tag">01</span><div><h3>Assessments and technology roadmaps</h3><p>Current-state review, account and identity questions, backup awareness, vendor context, priority risks, and a practical next-step plan.</p></div></article>
				<article><span class="offer-tag">02</span><div><h3>Projects and remediation</h3><p>Network improvements, migrations, Microsoft 365 work, recovery planning, documentation, modernization, and other clearly scoped outcomes.</p></div></article>
				<article><span class="offer-tag">03</span><div><h3>AI and automation enablement</h3><p>Use-case discovery, tool evaluation, safer configuration, workflow design, staff enablement, and implementation support.</p></div></article>
				<article><span class="offer-tag">04</span><div><h3>Advisory and established-client support</h3><p>Technology decisions, vendor review, second opinions, and a trusted person to call when a known customer needs another piece of work.</p></div></article>
			</div>
		</div>
	</section>

	<section class="section fit-section">
		<div class="section-inner fit-grid">
			<div>
				<p class="eyebrow">A good fit when</p>
				<h2>Your organization needs technology expertise more than it needs another platform.</h2>
				<ul class="check-list">
					<li><span>+</span><span>Your organization depends on email, cloud tools, devices, vendors, and shared information.</span></li>
					<li><span>+</span><span>You have a project, recurring problem, outage, risk, or important technology decision that needs a capable owner.</span></li>
					<li><span>+</span><span>You want practical guidance without enterprise theater or pressure to buy more than you need.</span></li>
				</ul>
			</div>
			<aside class="boundary-note">
				<p class="eyebrow">A clear boundary</p>
				<h3>The right scope for your organization.</h3>
				<p>If a project, assessment, or occasional trusted call is the right answer, that is a successful relationship. Ongoing services should exist because the work genuinely requires them.</p>
				<a class="text-link" href="/about">Read our approach <span aria-hidden="true">&#8594;</span></a>
			</aside>
		</div>
	</section>

	<section class="band">
		<div class="section-inner band-inner">
			<div><p class="eyebrow eyebrow-light">Start with the friction</p><h2>Let’s find your next step.</h2><p>Tell us what needs attention. We will help you understand the options and agree on a useful scope of work.</p></div>
			<a class="button button-light" href="/contact">Discuss your project</a>
		</div>
	</section>
</SiteLayout>
