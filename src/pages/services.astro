---
import SiteLayout from "../layouts/SiteLayout.astro";

const title = "How We Help | Cassady Tech Solutions";
const description = "Assessments, projects, advisory support, cybersecurity, incident help, automation, and AI enablement for small organizations.";

const serviceAreas = [
	{
		number: "01",
		title: "Assessments and technology roadmaps",
		intro: "Understand what exists before making another change.",
		body: "A focused assessment creates a usable picture of the organization: users, devices, accounts, Microsoft 365, backups, vendors, network dependencies, documentation, technology spend, and the risks or friction that deserve attention first.",
		items: ["Current-state discovery", "Account and identity review", "Backup and recovery review", "Prioritized technology roadmap"],
	},
	{
		number: "02",
		title: "Projects, remediation, and recovery",
		intro: "Take one important outcome from unclear to complete.",
		body: "We scope migrations, network improvements, Microsoft 365 work, documentation, recovery planning, vendor transitions, security remediation, and other technology changes around an explicit outcome, boundary, and acceptance point.",
		items: ["Network and infrastructure improvements", "Migrations and implementations", "Security and recovery remediation", "Documentation and vendor transitions"],
	},
	{
		number: "03",
		title: "AI and automation enablement",
		intro: "Find the useful use case before buying another tool.",
		body: "We help organizations decide where AI or automation can reduce repetitive work without losing control of sensitive information, quality, or accountability. The first step is usually a workflow conversation, not a platform pitch.",
		items: ["Workflow and use-case discovery", "Tool and integration evaluation", "Safe configuration and data boundaries", "Implementation and staff enablement"],
	},
	{
		number: "04",
		title: "Advisory and established-client support",
		intro: "Have somebody who already understands the context when the next decision appears.",
		body: "Some organizations need periodic technology judgment more than continuous IT management. We can help with vendor decisions, second opinions, planning, and discrete support for established customers without pretending every relationship needs to become a monthly managed service.",
		items: ["Technology decisions and second opinions", "Vendor and spend review", "Periodic advisory", "Defined follow-on support for established clients"],
	},
];
---

<SiteLayout title={title} description={description} active="services">
	<section class="page-title page-title-dark">
		<div class="section-inner page-title-grid">
			<div><p class="eyebrow eyebrow-light">How we help</p><h1>Technology work for organizations that need a capable next move.</h1><p>CTS is built around assessments, projects, advisory work, incident help, and repeat relationships. We start with the problem in front of the organization and only add ongoing responsibility when it is truly useful.</p></div>
			<div class="page-marker"><span>CTS / 01</span><strong>Useful work<br />with context</strong></div>
		</div>
	</section>

	<section class="section service-areas-section">
		<div class="section-inner">
			<div class="section-heading wide-heading"><p class="eyebrow">Four ways to start</p><h2>The right engagement depends on what the organization needs next.</h2><p>These are service areas, not locked packages. We scope the work around the environment, the outcome, the available capacity, and the level of ongoing responsibility the customer can actually use.</p></div>
			<div class="service-rail">
				{serviceAreas.map((service) => (
					<article class="service-rail-row">
						<div class="service-rail-number">{service.number}</div>
						<div class="service-rail-main"><h2>{service.title}</h2><p class="service-intro">{service.intro}</p><p>{service.body}</p></div>
						<ul class="service-includes">{service.items.map((item) => <li><span>+</span>{item}</li>)}</ul>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section alt-section engagement-section">
		<div class="section-inner engagement-grid">
			<div class="section-heading"><p class="eyebrow">A sensible starting point</p><h2>You do not need a perfect brief before the first conversation.</h2><p>Bring the symptoms, the outage, the decision you are avoiding, or the project that keeps stalling. We can help sort the problem before recommending a solution.</p></div>
			<div class="engagement-notes"><article><span>1</span><div><h3>Listen for the operating problem</h3><p>What is slowing work, creating avoidable risk, or consuming more attention than it should?</p></div></article><article><span>2</span><div><h3>Define the useful boundary</h3><p>What belongs in an immediate fix, an assessment, a project, advisory work, or a longer-term relationship?</p></div></article><article><span>3</span><div><h3>Agree on the next piece of work</h3><p>You should know what happens next, what it will require, what is outside the scope, and what responsibility remains after the work is complete.</p></div></article></div>
		</div>
	</section>

	<section class="section not-fit-section">
		<div class="section-inner not-fit-grid"><div><p class="eyebrow">What we do not sell</p><h2>Confidence theater.</h2></div><div><p>We do not use enterprise-sounding promises to make a small organization feel underprotected. We will not claim guaranteed protection, 24/7 coverage, formal compliance consulting, or continuous management unless a specific engagement genuinely supports that claim.</p><p>We also will not push a monthly contract when a defined project or occasional trusted support is the better answer.</p></div></div>
	</section>

	<section class="band"><div class="section-inner band-inner"><div><p class="eyebrow eyebrow-light">Have a question about fit?</p><h2>Start with the situation as it is.</h2><p>We can talk through the current setup, the pressure point, and the most useful next piece of work.</p></div><a class="button button-light" href="/contact">Start a technology conversation</a></div></section>
</SiteLayout>
