---
interface Props {
	title: string;
	description: string;
	active?: "home" | "services" | "about" | "contact" | "privacy";
}

const { title, description, active = "home" } = Astro.props;
const navItems = [
	{ href: "/services", label: "How we help", key: "services" },
	{ href: "/about", label: "Our approach", key: "about" },
	{ href: "/contact", label: "Contact", key: "contact" },
];

const schema = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	name: "Cassady Tech Solutions",
	url: "https://cassadytech.com",
	email: "samuelc@cassadytech.com",
	telephone: "+1-719-781-2356",
	areaServed: ["Colorado Springs", "Pueblo", "Fountain", "Rye", "Walsenburg", "Southern Colorado"],
	description,
	serviceType: ["Managed technology operations", "Cybersecurity support", "AI and automation enablement"],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="keywords" content="technology partner Southern Colorado, small business IT support, Microsoft 365 support, cybersecurity support, AI integration small business" />
		<link rel="canonical" href={new URL(Astro.url.pathname, "https://cassadytech.com")} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={new URL(Astro.url.pathname, "https://cassadytech.com")} />
		<meta property="og:image" content="https://cassadytech.com/assets/brand/official-logo.jpg" />
		<meta property="og:image:alt" content="Cassady Tech Solutions mountain and technology logo" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://cassadytech.com/assets/brand/official-logo.jpg" />
		<meta name="robots" content="index, follow" />
		<title>{title}</title>
		<link rel="icon" href="/assets/brand/official-logo.jpg" type="image/jpeg" />
		<link rel="stylesheet" href="/assets/css/styles.css" />
		<script type="application/ld+json" set:html={JSON.stringify(schema)}></script>
	</head>
	<body>
		<header class="site-header">
			<div class="nav-wrap">
				<a class="brand" href="/" aria-label="Cassady Tech Solutions home">
					<img src="/assets/brand/official-logo.jpg" alt="" />
					<span class="brand-text">
						<span>Cassady Tech Solutions</span>
						<span>Technology for organizations</span>
					</span>
				</a>
				<button class="nav-toggle" type="button" aria-label="Open navigation" aria-expanded="false" data-nav-toggle>
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
				</button>
				<nav class="site-nav" aria-label="Primary navigation" data-site-nav>
					{navItems.map((item) => (
						<a class:list={{ "is-active": active === item.key }} href={item.href}>{item.label}</a>
					))}
					<a class="nav-cta" href="/contact">Schedule a review</a>
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="section-inner footer-grid">
				<div class="footer-intro">
					<a class="footer-brand" href="/">Cassady Tech Solutions</a>
					<p class="small">Technology for organizations. Practical operations, safer systems, and thoughtful modernization for Southern Colorado.</p>
				</div>
				<div>
					<p class="footer-label">Explore</p>
					<nav class="footer-links" aria-label="Footer navigation">
						<a href="/services">How we help</a>
						<a href="/about">Our approach</a>
						<a href="/contact">Contact</a>
						<a href="/privacy">Privacy</a>
					</nav>
				</div>
				<div>
					<p class="footer-label">Start a conversation</p>
					<p class="small"><a href="mailto:samuelc@cassadytech.com">samuelc@cassadytech.com</a><br /><a href="tel:+17197812356">719-781-2356</a></p>
				</div>
			</div>
			<div class="section-inner legal-row">
				<p class="small">&copy; <span data-year></span> Cassady Tech Solutions LLC. Greenhorn Valley Tech is the residential brand.</p>
				<p class="small">Southern Colorado and remote-first service.</p>
			</div>
		</footer>
		<script is:inline src="/assets/js/site.js"></script>
	</body>
</html>
